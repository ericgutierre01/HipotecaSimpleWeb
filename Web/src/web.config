<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: tipos de archivo que no conoce por defecto y que la app necesita para poder instalarse -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
